n = input_int
items = arena int()
sum = 0
i = 0
repeat n
insert items, i as stale
lookup items, stale as value
sum = sum + value
else
sum = sum + 1000000000
end
remove items, stale as removed
sum = sum + removed
else
sum = sum + 1000000000
end
insert items, i + 1 as fresh
lookup items, stale as old
sum = sum + 1000000000
else
sum = sum + 1
end
lookup items, fresh as value2
sum = sum + value2
else
sum = sum + 1000000000
end
remove items, fresh as removed2
sum = sum + removed2
else
sum = sum + 1000000000
end
i = i + 1
end
print sum
